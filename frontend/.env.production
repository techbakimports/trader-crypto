# No build de produção (npm run build), o frontend é servido pelo próprio
# backend (mesma origem) — deixa vazio pra usar caminhos relativos (/api/...)
# em vez de um host fixo. Isso já é o comportamento padrão do client.ts
# quando VITE_API_BASE_URL não está definido para produção; este arquivo só
# torna explícito, evitando que o valor de dev (localhost:8000) vaze pro build.
VITE_API_BASE_URL=
