# Obrigatórias para o scanner de tendência (main.py), que só alerta via Telegram.
# Opcionais para o radar de notícias / dashboard (news_main.py e server.py): se
# deixar em branco, os alertas simplesmente não são enviados — o histórico
# continua sendo salvo normalmente e aparece no dashboard.
TELEGRAM_BOT_TOKEN=coloque_o_token_do_seu_bot_aqui
TELEGRAM_CHAT_ID=coloque_o_chat_id_aqui
# Necessária apenas para o radar de notícias (news_main.py e o dashboard via server.py).
# Crie em https://console.groq.com (Groq — atenção, NÃO é a Grok/xAI, são serviços
# diferentes apesar do nome parecido). A chave da Groq começa com "gsk_".
GROQ_API_KEY=coloque_a_chave_da_groq_aqui

# Opcional: token gratuito da brapi.dev (https://brapi.dev), usado pelos dados de
# mercado da B3. Sem ele o client ainda funciona (rate limit mais restrito) e cai
# para o yfinance automaticamente se a brapi falhar.
BRAPI_TOKEN=

# Opcional: origens permitidas a consultar a API do dashboard (server.py), separadas
# por vírgula. Padrão: http://localhost:5173 (dev do frontend). Em produção, coloque
# a URL do frontend hospedado na Vercel.
DASHBOARD_ALLOWED_ORIGINS=http://localhost:5173
